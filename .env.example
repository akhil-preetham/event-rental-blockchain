# Backend development configuration.
# This file is documentation only; the application does not load .env files automatically.

NODE_ENV=development
PORT=8787
APP_ORIGIN=http://localhost:5173

# Optional: defaults to backend/eventrent-auth.sqlite.
AUTH_DB_PATH=

# Local Hardhat RPC and deployment configuration.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
RENTAL_ESCROW_ADDRESS=
# Deployment is opt-in. Set to 1 only for an intentional local deployment.
RENTAL_ESCROW_DEPLOY=
BLOCKCHAIN_CONFIRMATIONS=2
BLOCKCHAIN_RPC_TIMEOUT_MS=10000
